{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FishTime",
  "version": "4.0.6",
  "identifier": "com.fishtime.desktop",
  "build": {
    "beforeDevCommand": "npm run prepare:web",
    "beforeBuildCommand": "npm run prepare:web",
    "frontendDist": "../.tauri-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FishTime",
        "width": 1000,
        "height": 700,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.siliconflow.cn https://generativelanguage.googleapis.com; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/fishtime.icns"],
    "category": "Productivity",
    "shortDescription": "Local work timer and statistics",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    }
  }
}
