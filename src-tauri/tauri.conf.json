{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FishTime",
  "version": "5.2.0",
  "identifier": "com.fishtime.desktop",
  "build": {
    "beforeDevCommand": "npm run prepare:web",
    "beforeBuildCommand": "npm run prepare:web",
    "frontendDist": "../.tauri-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FishTime",
        "width": 1000,
        "height": 700,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.siliconflow.cn https://generativelanguage.googleapis.com; img-src 'self' data: blob:; media-src 'self' blob: asset: http://asset.localhost https://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/music/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/fishtime.icns"
    ],
    "category": "Productivity",
    "shortDescription": "Local work timer and statistics",
    "macOS": {
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVFMDUwOTcxRDUwNUFGOTcKUldTWHJ3WFZjUWtGN3JzQzhOYk84TDUxT2E3ZWU0dm9rYmdlQ1FVOWcxcERwMUxCQW90OVdIc2wK",
      "endpoints": [
        "https://github.com/pxxiao-hz/FishTime/releases/latest/download/latest.json"
      ]
    }
  }
}
